# Copy to .env (git-ignored) and adjust.

# Where the web server listens. 127.0.0.1 = this PC only.
# 0.0.0.0 = reachable from your phone on the same Wi-Fi (http only; bench use).
HOST=127.0.0.1
PORT=3000

# ---- MQTT broker ----
# Local dev broker (npm run broker):
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# HiveMQ Cloud: use a SEPARATE credential from the hub's, e.g. "securesense-web":
# MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=securesense-web
# MQTT_PASSWORD=...
MQTT_TOPIC_PREFIX=securesense/hub1
NODE_ID=2

# ---- Database & sessions ----
DB_PATH=data/securesense.db
SESSION_DAYS=7
# true once served over HTTPS (keeps the session cookie off plain HTTP)
COOKIE_SECURE=false

# ---- First user ----
# Created on first start if no users exist. Min 10 characters.
# Remove these lines afterwards; manage users with:  npm run user -- add <name>
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
